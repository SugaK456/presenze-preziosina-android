<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sfondo"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <!-- intestazione -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Presenze"
            android:textColor="@color/scuro"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Residenza Preziosina"
            android:textColor="@color/grigio"
            android:textSize="15sp" />

        <!-- HERO: omina appesa + stato -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/hero"
                android:elevation="3dp"
                android:minHeight="196dp"
                android:orientation="vertical"
                android:paddingStart="148dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/t_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_ok"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="✓ Collegata"
                    android:textColor="@color/verde"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/t_grande"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Sei DENTRO"
                    android:textColor="@color/verde"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/t_stato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/grigio"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/t_fumetto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/fumetto_allerta"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Controlla che il tuo status sia veritiero!"
                    android:textColor="@color/scuro"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- sbarra + omina (sopra la card) -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="5dp"
                android:elevation="4dp"
                android:scaleType="fitXY"
                android:src="@drawable/barra" />

            <ImageView
                android:id="@+id/i_omina"
                android:layout_width="132dp"
                android:layout_height="178dp"
                android:layout_marginStart="10dp"
                android:elevation="5dp"
                android:scaleType="fitStart"
                android:src="@drawable/omina_felice" />
        </FrameLayout>

        <!-- pulsanti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/b_esco"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/btn_esco_off"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="🚪  Esco"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/b_rientro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/btn_rientro_off"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="🏠  Rientro"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- collegamento (visibile solo se non collegata) -->
        <LinearLayout
            android:id="@+id/sezione_collega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="🔗 Collega l'app"
                android:textColor="@color/scuro"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="1. Apri la web app delle presenze e accedi.\n2. Premi «📲 Pulsante sul telefono» → «Crea il mio pulsante».\n3. Premi «Collega l'app Android»: torni qui già collegata."
                android:textColor="@color/grigio"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/b_web"
                style="@style/Bottone.Scuro"
                android:layout_marginTop="14dp"
                android:text="Apri la web app" />

            <TextView
                android:id="@+id/b_incolla"
                style="@style/Bottone.Chiaro"
                android:layout_marginTop="8dp"
                android:text="Ho copiato il link: incolla e collega" />

            <EditText
                android:id="@+id/campo_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="preziosina://collega?…"
                android:inputType="textUri"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/b_collega"
                style="@style/Bottone.Chiaro"
                android:layout_marginTop="4dp"
                android:text="Collega" />
        </LinearLayout>

        <!-- promemoria -->
        <LinearLayout
            android:id="@+id/sezione_promemoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="🔔 Promemoria"
                    android:textColor="@color/scuro"
                    android:textSize="18sp" />

                <Switch
                    android:id="@+id/s_promemoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/t_orari"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/grigio"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/b_permesso"
                style="@style/Bottone.Scuro"
                android:layout_marginTop="12dp"
                android:text="Consenti le notifiche"
                android:visibility="gone" />
        </LinearLayout>

        <!-- widget -->
        <LinearLayout
            android:id="@+id/sezione_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="📱 Widget sulla Home"
                android:textColor="@color/scuro"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Un tocco su ESCO o RIENTRO e lo stato parte, senza aprire l'app."
                android:textColor="@color/grigio"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/b_widget"
                style="@style/Bottone.Scuro"
                android:layout_marginTop="12dp"
                android:text="➕ Aggiungi il widget alla Home" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingExtra="3dp"
            android:text="Serve solo per le emergenze: dice ai soccorsi chi potrebbe essere ancora in residenza. L'app invia esclusivamente DENTRO/FUORI: nessuna posizione, nessuno storico. Senza rete l'invio parte appena torna il segnale."
            android:textColor="@color/grigio"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/b_scollega"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:text="Scollega l'app"
            android:textColor="@color/grigio"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
