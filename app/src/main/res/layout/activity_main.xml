<?xml version="1.0" encoding="utf-8"?>
<!-- Stile coerente con la web app: barra scura, sfondo grigio chiaro, card bianche con bordo sottile -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scuro"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- barra superiore -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/scuro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/icona_tonda"
            android:clipToOutline="true"
            android:src="@drawable/icona_app" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Presenze"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preziosina · Residente"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:id="@+id/v_online"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:background="@drawable/punto_online" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/sfondo"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- interruttore grande, come nella web app: tocca per cambiare -->
            <LinearLayout
                android:id="@+id/sw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/switch_dentro"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:minHeight="380dp"
                android:orientation="vertical"
                android:paddingTop="28dp"
                android:paddingBottom="30dp">

                <FrameLayout
                    android:layout_width="190dp"
                    android:layout_height="190dp">

                    <View
                        android:layout_width="174dp"
                        android:layout_height="9dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/sbarra_bianca" />

                    <ImageView
                        android:id="@+id/i_omina"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:src="@drawable/tessera_neutra" />

                    <!-- numero della stanza stampato sulla tessera -->
                    <TextView
                        android:id="@+id/t_stanza"
                        android:layout_width="86dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="78dp"
                        android:layout_marginTop="85dp"
                        android:autoSizeMaxTextSize="27sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="–"
                        android:textColor="#1E1B3A" />
                </FrameLayout>

                <TextView
                    android:id="@+id/t_grande"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="DENTRO"
                    android:textColor="#FFFFFF"
                    android:textSize="58sp" />

                <TextView
                    android:id="@+id/t_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Tocca quando esci"
                    android:textColor="#F1F5F9"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- riga di stato (come nella web app) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/t_stato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/grigio"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bordo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- avviso dell'ora di promemoria -->
                <LinearLayout
                    android:id="@+id/banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/banner_allerta"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Controlla che il tuo status sia veritiero"
                        android:textColor="@color/giallo"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/t_banner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/giallo"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- collegamento (solo se non collegata) -->
                <LinearLayout
                    android:id="@+id/sezione_collega"
                    style="@style/Card">

                    <TextView
                        style="@style/TitoloCard"
                        android:text="Collega l'app al tuo profilo" />

                    <TextView
                        style="@style/TestoCard"
                        android:text="1. Apri la web app delle presenze e accedi.\n2. Premi «Pulsante sul telefono» e crea il tuo pulsante.\n3. Premi «Collega l'app Android»: torni qui già collegata." />

                    <TextView
                        android:id="@+id/b_web"
                        style="@style/Bottone.Scuro"
                        android:layout_marginTop="14dp"
                        android:text="Apri la web app" />

                    <TextView
                        android:id="@+id/b_incolla"
                        style="@style/Bottone.Chiaro"
                        android:layout_marginTop="8dp"
                        android:text="Ho copiato il link: incolla e collega" />

                    <EditText
                        android:id="@+id/campo_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="preziosina://collega?…"
                        android:inputType="textUri"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/b_collega"
                        style="@style/Bottone.Chiaro"
                        android:layout_marginTop="4dp"
                        android:text="Collega" />
                </LinearLayout>

                <!-- promemoria -->
                <LinearLayout
                    android:id="@+id/sezione_promemoria"
                    style="@style/Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TitoloCard"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="Promemoria" />

                        <Switch
                            android:id="@+id/s_promemoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/t_orari"
                        style="@style/TestoCard" />

                    <TextView
                        android:id="@+id/b_permesso"
                        style="@style/Bottone.Scuro"
                        android:layout_marginTop="12dp"
                        android:text="Consenti le notifiche"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- widget -->
                <LinearLayout
                    android:id="@+id/sezione_widget"
                    style="@style/Card">

                    <TextView
                        style="@style/TitoloCard"
                        android:text="Widget sulla schermata Home" />

                    <TextView
                        style="@style/TestoCard"
                        android:text="Pulsanti ESCO e RIENTRO sulla Home: un tocco e lo stato parte, senza aprire l'app." />

                    <TextView
                        android:id="@+id/b_widget"
                        style="@style/Bottone.Scuro"
                        android:layout_marginTop="12dp"
                        android:text="Aggiungi il widget alla Home" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Serve solo per le emergenze: dice ai soccorsi chi potrebbe essere ancora in residenza. L'app invia esclusivamente DENTRO/FUORI: nessuna posizione, nessuno storico. Senza rete l'invio parte appena torna il segnale."
                    android:textColor="@color/grigio"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/b_scollega"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:text="Scollega l'app"
                    android:textColor="@color/grigio"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
