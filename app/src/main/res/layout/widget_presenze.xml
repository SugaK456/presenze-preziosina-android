<?xml version="1.0" encoding="utf-8"?>
<!-- Widget: la tessera è appesa alla sbarra in alto; a destra il fumetto e i pulsanti -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:paddingStart="118dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/w_fumetto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fumetto"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/w_titolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="Ciao! Collegami all'app"
                android:textColor="#1E1B3A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_sotto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tocca qui per aprirla"
                android:textColor="#6B6889"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_esco"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_esco_off"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="🚪 ESCO"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_rientro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/btn_rientro_off"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="🏠 RIENTRO"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- sbarra a cui si aggrappa -->
    <ImageView
        android:layout_width="108dp"
        android:layout_height="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/widget_barra"
        android:scaleType="fitXY" />

    <!-- l'omina -->
    <ImageView
        android:id="@+id/w_omina"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginStart="2dp"
        android:scaleType="fitStart"
        android:src="@drawable/tessera_neutra" />
</FrameLayout>
